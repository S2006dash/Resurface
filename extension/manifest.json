{
  "manifest_version": 3,
  "name": "Artha - Financial Well-Being & Safe-to-Spend",
  "version": "1.0.0",
  "description": "Your private money companion: Real-time Safe-to-Spend checkout guardian, receipt clipper, and in-page financial Jargon Buster.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Artha Quick View",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/jargon.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "*://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "shared/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}

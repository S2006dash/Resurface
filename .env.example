# Copy to .env and fill in real values. Never commit .env — repo is public.

# PostgreSQL
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/artha_db

# Flask
SECRET_KEY=replace-with-a-long-random-string
FLASK_ENV=development

# Gemma 4 via Gemini API  →  https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# LLM backend: "gemini" for cloud, "ollama" for local private mode
LLM_PROVIDER=gemini

# Ollama (private mode, P2)
OLLAMA_MODEL=gemma4:e4b
OLLAMA_BASE_URL=http://localhost:11434

# DigitalOcean App Platform sets these automatically
# BACKEND_URL=https://your-app.ondigitalocean.app
